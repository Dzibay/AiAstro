# Имя продукта. Показывается, если в базе ещё нет site_name.
SITE_NAME=Астра

# Единственный env-файл проекта: скопируйте в .env рядом с docker-compose.yml.
# Его читают docker compose (backend, postgres, caddy) и локальный python run_api.py.

# Публичный адрес. Caddy берёт из него хост (без www — www перенаправит сюда с тем же путём).
# https://домен — Caddy сам получит сертификат Let's Encrypt (DNS домена должен указывать
# на сервер, порты 80 и 443 открыты). http://... или localhost — без HTTPS, на :80.
# Этот же адрес ЮKassa использует для возврата в кабинет после оплаты (/cabinet).
PUBLIC_BASE_URL=http://localhost

# Почта для уведомлений Let's Encrypt. Необязательно.
ACME_EMAIL=

# Локальный python run_api.py ходит на localhost.
# В compose хост и порт переопределяются на postgres:5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aiastro
DB_USER=aiastro
# DB_PASSWORD обязателен для compose. Postgres применяет его только при первом
# создании тома postgres_data — менять потом нужно через ALTER USER.
DB_PASSWORD=

# Секреты сессий — длинные случайные строки (например: openssl rand -hex 32).
# Пустые значения не роняют процесс:
# вход в кабинет и админку просто остаётся закрытым.
WEB_SESSION_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# Срок сессии кабинета и админки, секунды. 14 дней.
SESSION_TTL_SECONDS=1209600
