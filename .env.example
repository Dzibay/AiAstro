# Имя продукта. Показывается, если в базе ещё нет site_name.
SITE_NAME=Астра

# Публичный адрес. Caddy берёт из него хост.
# Локально без домена: http://localhost
PUBLIC_BASE_URL=http://localhost

# Локальный python run_api.py ходит на localhost.
# В compose хост переопределяется на postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aiastro
DB_USER=aiastro
DB_PASSWORD=

# Секреты сессий. Пустые значения не роняют процесс:
# вход в кабинет и админку просто остаётся закрытым.
WEB_SESSION_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# Срок сессии кабинета и админки, секунды. 14 дней.
SESSION_TTL_SECONDS=1209600
